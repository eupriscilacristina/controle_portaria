rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }

    function ehAdmin() {
      return autenticado()
        && exists(/databases/$(database)/documents/administradores/$(request.auth.uid));
    }

    match /administradores/{uid} {
      allow read: if autenticado() && request.auth.uid == uid;
      allow write: if false;
    }

    match /pessoas/{pessoa} {
      allow read: if autenticado();
      allow create, update, delete: if ehAdmin();
    }

    match /acessos/{acesso} {
      allow read: if autenticado();
      allow create: if autenticado()
        && request.resource.data.status == 'dentro'
        && request.resource.data.dataEntrada is timestamp
        && request.resource.data.dataSaida == null;
      allow update: if ehAdmin()
        || (autenticado()
          && resource.data.status == 'dentro'
          && request.resource.data.status == 'fora'
          && request.resource.data.dataSaida is timestamp
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'dataSaida']));
      allow delete: if ehAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}